# IndexFeed — Algorand edition
#
# Copy to .env and fill in. Nothing here is loaded from a committed file: .env is
# gitignored, and the only genuinely secret value is ATTEST_PRIVATE_KEY.
#
# The payout mnemonic is deliberately NOT in this file. The API never signs an
# Algorand transaction — receiving an ASA transfer needs no signature — so the
# payout key belongs in a password manager and nowhere near the repo.

# ---------------------------------------------------------------------------
# Network. Start on testnet; only mainnet counts toward the challenge leaderboard.
# ---------------------------------------------------------------------------
ALGORAND_NETWORK=testnet

# Where USDC lands. Generate with `npm run account:new`, then opt it in to USDC
# with `npm run account:optin -- "<mnemonic>"` or it cannot be paid at all.
#
# This address is the competition's attribution key and is fixed for the whole
# run — changing it starts a new merchant with no history rather than moving
# volume across. Verify with `npm run account:check`.
X402_PAY_TO=

# ---------------------------------------------------------------------------
# Payment. The facilitator is mandated by the challenge rules; a local or
# alternative facilitator does not count.
# ---------------------------------------------------------------------------
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_CHALLENGE_TAG=x402-global-challenge

# Public origin, used for the resource URLs advertised to the Bazaar catalog.
# Required in production: behind a proxy the request host is the internal one, so
# without this the catalog lists a URL no caller can reach while payments still
# settle normally.
# PUBLIC_BASE_URL=https://indexfeed-production.up.railway.app

# ---------------------------------------------------------------------------
# Price grid, in USD. Overrides the defaults in packages/api/src/config.js.
#
# PRICE_TICK is an order of magnitude below the rest on purpose: it is the only
# route designed to be polled continuously, and it has to be cheap enough that
# sustained polling is rational for the payer.
# ---------------------------------------------------------------------------
# PRICE_TICK=$0.001
# PRICE_LATEST=$0.01
# PRICE_CONSTITUENTS=$0.01
# PRICE_HISTORY=$0.02
# PRICE_QUOTE=$0.005
# PRICE_MARKET=$0.01
# PRICE_ASSET=$0.005

# ---------------------------------------------------------------------------
# Data freshness. The gate refuses to sell price-derived data older than
# PRICE_MAX_STALE_SECONDS, and it refuses *before* payment settles.
# ---------------------------------------------------------------------------
PRICE_TTL_SECONDS=20
PRICE_MAX_STALE_SECONDS=180

# ---------------------------------------------------------------------------
# Epoch attestation. Optional: without it epochs are digest-checkable but
# unsigned, and `/` reports that honestly rather than implying a signature.
# Generate with `npm run attest-key --workspace @indexfeed-algorand/engine`.
# Base64 form avoids the newline mangling that breaks PEM in most secret stores.
# ---------------------------------------------------------------------------
# ATTEST_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Storage and server
# ---------------------------------------------------------------------------
STATE_DIR=./state
PORT=3002

# Offline mode: fixtures instead of live providers, in their own state directory
# so a fixture-computed divisor can never become the basis for a real epoch.
# USE_FIXTURE_PRICES=1

# ---------------------------------------------------------------------------
# Reference consumer (packages/client). Separate wallet from X402_PAY_TO.
# MAX_SPEND_USDC is a hard stop checked before every request.
# ---------------------------------------------------------------------------
# PAYER_MNEMONIC=
# POLL_URL=https://indexfeed-production.up.railway.app/v1/index/tick
# POLL_INTERVAL_SECONDS=30
# MAX_SPEND_USDC=1
# POLL_PRICE_USDC=0.001
